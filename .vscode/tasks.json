{
    // See https://go.microsoft.com/fwlink/?LinkId=733558 
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build ...",
            "command": "g++",
            "args": [
                "-g0",
                "-O3",
                "${workspaceFolder}/parser.cpp",
                "${workspaceFolder}/utilstrencodings.cpp",
                "-I${workspaceFolder}/rapidjson/include",
                "-I${workspaceFolder}/depends_build/include",
                "-std=c++11",
                "-L${workspaceFolder}/depends_build/lib",
                "-Wl,-Bstatic",
                "-lbitcoin-system",
                "-lsecp256k1",
                "-Wl,-Bdynamic",
                "-lboost_system",
                "-lboost_thread",
                "-lboost_program_options",
                "-lboost_regex",
                "-lgmp",
                "-o",
                "${workspaceFolder}/parser"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        }
    ]
}